#!/bin/bash
# AppImage entry point. Bundled libraries live in usr/lib; the staged app dist
# keeps its own layout under opt/station-scout with rpaths patched by
# linuxdeploy to reach usr/lib.
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/opt/station-scout/StationScout" "$@"
